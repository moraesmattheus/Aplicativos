{
  "manifest_version": 3,
  "name": "Omnivix",
  "version": "1.1.0",
  "description": "Foco, tarefas, abas e reuniões num só lugar: grava, transcreve e resume reuniões, e organiza seu dia. Grátis.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "notifications",
    "sidePanel",
    "alarms",
    "idle",
    "contextMenus"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.assemblyai.com/*",
    "https://api.notion.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:8787/*"
  ],
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Omnivix"
  },
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "side_panel": {
    "default_path": "foco/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "description": "Abrir o painel",
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    },
    "gravar-reuniao": {
      "description": "Gravar ou parar a reunião da aba atual",
      "suggested_key": {
        "default": "Alt+Shift+G"
      }
    }
  }
}
