# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" NUNCA vai para o git.
# Nunca cole chaves em chat, codigo ou prints.

# Chave da API da Anthropic (crie em console.anthropic.com)
ANTHROPIC_API_KEY=

# Senha inventada por voce, longa e aleatoria. A extensao envia esta senha em cada chamada.
# Para gerar uma:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Modelo usado (opcional). Haiku e rapido e barato para agrupar abas.
MODEL=claude-haiku-4-5-20251001
