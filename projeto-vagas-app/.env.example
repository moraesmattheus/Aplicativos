# MODELO do arquivo .env (este arquivo pode ir para o Git, ele NAO tem chaves reais).
#
# Como usar:
#   1. Copie este arquivo para um novo arquivo chamado ".env" (na mesma pasta).
#   2. Preencha os valores com as SUAS chaves.
#   3. NUNCA coloque chaves reais neste arquivo, no CHANGELOG nem em nenhum outro
#      arquivo do repositorio. O ".env" ja esta no .gitignore e nao sobe para o GitHub.
#
# Para os builds do EAS, cadastre os mesmos nomes como Secrets em https://expo.dev
# (projeto > Environment variables), com visibilidade "Sensitive".

# JSearch (RapidAPI)
EXPO_PUBLIC_JSEARCH_KEY=

# Adzuna (App ID e Key)
EXPO_PUBLIC_ADZUNA_APP_ID=
EXPO_PUBLIC_ADZUNA_APP_KEY=

# Jooble
EXPO_PUBLIC_JOOBLE_KEY=
